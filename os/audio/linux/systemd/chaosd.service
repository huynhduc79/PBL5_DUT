[Unit]
Description=PBL5 chaosd - nhan ban ma tu RTOS (RPMsg) va ghi file .chau
# /dev/ttyRPMSG0 chi xuat hien sau khi RTOS announce kenh
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do [ -e /dev/ttyRPMSG0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /opt/chaos/chaosd.py --config /etc/chaosd.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
